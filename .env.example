# Copy to .env.local and fill in. Never commit .env files.

# From Supabase dashboard -> Project Settings -> API
# (or from `npx supabase start` output when running Supabase locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the site (used for auth redirects later)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
# Optional until a later slice needs it.
SUPABASE_SERVICE_ROLE_KEY=
