# Copy to .env.local and fill in. Never commit .env files.

# From Supabase dashboard -> Project Settings -> API
# (or from `npx supabase start` output when running Supabase locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the site (used in auth emails and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
# Required: used for pseudonym assignment and account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Work-email verification (Slice 6). Without RESEND_API_KEY, /me/verify says
# "not switched on yet". EMAIL_FROM_ADDRESS must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
# Local development only: send through Supabase's Mailpit inbox instead of Resend.
# MAILPIT_URL=http://127.0.0.1:54324
